  },
  "dependencies": {
    "commander": "^15.0.0",
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "openapi-typescript": "^7.13.0",
    "typescript": "5"
  }
}
