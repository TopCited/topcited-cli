{
  "name": "topcited-cli-workspace",
  "version": "0.1.1",
  "license": "MIT",
  "private": true,
  "description": "TopCited CLI source (published to npm as @topcited/cli via npm/)",
  "type": "module",
  "bin": {
    "topcited": "src/index.ts"
  },
  "scripts": {
